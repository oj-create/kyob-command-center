{
  "name": "kyob-command-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "globals": {
      "ts-jest": {
        "tsconfig": {
          "module": "commonjs",
          "moduleResolution": "node"
        }
      }
    }
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "^15.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "caniuse-lite": "^1.0.30001799",
    "eslint": "^9",
    "eslint-config-next": "^15.3.3",
    "jest": "^30.4.2",
    "jest-environment-node": "^30.4.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.11",
    "typescript": "^5"
  }
}
